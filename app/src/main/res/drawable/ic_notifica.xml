<?xml version="1.0" encoding="utf-8"?>
<!-- Small notification icon: the timeline dot (ring + solid dot).
     Android only uses the SHAPE and colours it itself: white in the top bar,
     light blue inside the notification (setColor in NotificationHelper). -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="24"
    android:viewportHeight="24">
    <!-- the ring -->
    <path
        android:fillColor="#00000000"
        android:pathData="M12,3a9,9 0,1 1,0 18a9,9 0,1 1,0 -18z"
        android:strokeWidth="2.4"
        android:strokeColor="#FFFFFFFF" />
    <!-- the solid dot in the centre -->
    <path
        android:fillColor="#FFFFFFFF"
        android:pathData="M12,7.5a4.5,4.5 0,1 1,0 9a4.5,4.5 0,1 1,0 -9z" />
</vector>
