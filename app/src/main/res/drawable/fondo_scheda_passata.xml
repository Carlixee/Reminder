<?xml version="1.0" encoding="utf-8"?>
<!-- A past reminder's card: only the border. The "mask" tells the touch ripple
     to fill the whole card (without it, it would only show on the thin border). -->
<ripple xmlns:android="http://schemas.android.com/apk/res/android" android:color="#26BBDEFB">
    <item>
        <shape>
            <corners android:radius="18dp" />
            <stroke android:width="1.5dp" android:color="@color/bordo_passato" />
        </shape>
    </item>
    <item android:id="@android:id/mask">
        <shape>
            <corners android:radius="18dp" />
            <solid android:color="#FFFFFFFF" />
        </shape>
    </item>
</ripple>
