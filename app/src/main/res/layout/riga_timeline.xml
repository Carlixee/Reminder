<?xml version="1.0" encoding="utf-8"?>
<!-- A row of the timeline, the same for past and future
     (only colours and dot change, decided by the code).
     Three columns: date (56dp) | dot with the line (24dp) | card.
     With large text the date narrows to stay on one line, and the time goes under the title. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal">

    <LinearLayout
        android:layout_width="56dp"
        android:layout_height="wrap_content"
        android:layout_gravity="center_vertical"
        android:orientation="vertical">

        <TextView
            android:id="@+id/testoGiorno"
            android:layout_width="match_parent"
            android:maxLines="1"
            android:autoSizeTextType="uniform"
            android:autoSizeMinTextSize="7sp"
            android:autoSizeMaxTextSize="11sp"
            android:autoSizeStepGranularity="0.5sp"
            android:layout_height="wrap_content"
            android:fontFamily="@font/jakarta_extrabold"
            android:letterSpacing="0.08"
            android:textColor="@color/testo_tenue"
            android:textSize="11sp" />

        <TextView
            android:id="@+id/testoData"
            android:layout_width="match_parent"
            android:maxLines="1"
            android:autoSizeTextType="uniform"
            android:autoSizeMinTextSize="7sp"
            android:autoSizeMaxTextSize="14sp"
            android:autoSizeStepGranularity="0.5sp"
            android:layout_height="wrap_content"
            android:fontFamily="@font/jakarta_extrabold"
            android:textColor="@color/testo_principale"
            android:textSize="14sp" />
    </LinearLayout>

    <!-- The line passes behind the dot: one piece above, one below -->
    <LinearLayout
        android:layout_width="24dp"
        android:layout_height="match_parent"
        android:gravity="center_horizontal"
        android:orientation="vertical">

        <View
            android:id="@+id/lineaSopra"
            android:layout_width="2dp"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:background="@color/linea_futura" />

        <View
            android:id="@+id/punto"
            android:layout_width="14dp"
            android:layout_height="14dp"
            android:background="@drawable/punto_futuro" />

        <View
            android:id="@+id/lineaSotto"
            android:layout_width="2dp"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:background="@color/linea_futura" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/scheda"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="10dp"
        android:layout_marginTop="7dp"
        android:layout_marginBottom="7dp"
        android:layout_weight="1"
        android:background="@drawable/fondo_scheda"
        android:orientation="vertical"
        android:paddingStart="14dp"
        android:paddingTop="12dp"
        android:paddingEnd="14dp"
        android:paddingBottom="12dp">

        <!-- [bell + title] [time]. With large text the time goes below (impila) -->
        <LinearLayout
            android:id="@+id/rigaTitolo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center_vertical"
                android:orientation="horizontal">

            <!-- Crossed-out bell: alerts off -->
            <ImageView
                android:id="@+id/iconaSpenta"
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:layout_marginEnd="8dp"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_campana_spenta"
                android:visibility="gone"
                app:tint="@color/testo_tenue" />

            <TextView
                android:id="@+id/testoTitolo"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:fontFamily="@font/jakarta_bold"
                android:textColor="@color/testo_principale"
                android:textSize="16sp" />
            </LinearLayout>

            <TextView
                android:id="@+id/testoOra"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:fontFamily="@font/jakarta_semibold"
                android:textColor="@color/testo_secondario"
                android:textSize="14sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/testoRipeti"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:drawableStart="@drawable/ic_ripeti_piccola"
            android:drawablePadding="6dp"
            android:drawableTint="@color/azzurro_chiaro"
            android:fontFamily="@font/jakarta_semibold"
            android:gravity="center_vertical"
            android:textColor="@color/azzurro_chiaro"
            android:textSize="12.5sp"
            android:visibility="gone" />
    </LinearLayout>
</LinearLayout>
