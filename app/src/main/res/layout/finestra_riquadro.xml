<?xml version="1.0" encoding="utf-8"?>
<!-- The dialog that opens when the tile in quick settings is tapped:
     the next 5 reminders. The rows are added by the code inside "elenco". -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/sfondo_dialogo"
    android:orientation="vertical"
    android:paddingStart="18dp"
    android:paddingTop="22dp"
    android:paddingEnd="18dp"
    android:paddingBottom="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="4dp"
        android:paddingEnd="4dp">

        <ImageView
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:importantForAccessibility="no"
            android:src="@drawable/ic_campana"
            app:tint="@color/azzurro_chiaro" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:fontFamily="@font/jakarta_extrabold"
            android:text="@string/tile_titolo"
            android:textColor="@color/testo_principale"
            android:textSize="20sp" />
    </LinearLayout>

    <!-- All the upcoming reminders; beyond the first 5 you scroll (the height
         is fixed by the code, so the dialog never gets taller than that).
         The fades at the top and bottom say there's more.
         layout_weight: if the dialog doesn't fit on the screen (large text) it's the list
         that gets shorter and scrolls, not the buttons at the bottom that get squashed. -->
    <ScrollView
        android:id="@+id/scorrimentoElenco"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:layout_marginTop="14dp"
        android:fadingEdgeLength="28dp"
        android:overScrollMode="never"
        android:requiresFadingEdge="vertical"
        android:scrollbars="none">

        <LinearLayout
            android:id="@+id/elenco"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />
    </ScrollView>

    <TextView
        android:id="@+id/testoVuoto"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:paddingStart="4dp"
        android:text="@string/tile_vuoto"
        android:textColor="@color/testo_secondario"
        android:textSize="15sp"
        android:visibility="gone" />

    <!-- Open the app … + New. With large text they don't fit side by side: "New" goes below, on the right -->
    <LinearLayout
        android:id="@+id/rigaBottoni"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/bottoneApriApp"
            style="@style/BottoneTesto"
            android:layout_width="wrap_content"
            android:text="@string/apri_app" />

        <Space
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <!-- Same colours as the app's "+ New". To close, just tap outside or back. -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/bottoneNuovo"
            style="@style/BottonePieno"
            android:layout_width="wrap_content"
            android:layout_gravity="end"
            android:paddingStart="20dp"
            android:text="@string/nuovo"
            android:textColor="@color/blu_profondo"
            app:backgroundTint="@color/azzurro_chiaro"
            app:icon="@drawable/ic_piu"
            app:iconPadding="6dp"
            app:iconSize="20dp"
            app:iconTint="@color/blu_profondo" />
    </LinearLayout>
</LinearLayout>
