<?xml version="1.0" encoding="utf-8"?>
<!-- One item of the tile's dialog: [TUE 10]  Ethical / 16:00 · in 3 days.
     The first one has the blue background (the code decides it). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="6dp"
    android:background="@drawable/fondo_voce"
    android:clickable="true"
    android:focusable="true"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="12dp"
    android:paddingTop="10dp"
    android:paddingEnd="12dp"
    android:paddingBottom="10dp">

    <LinearLayout
        android:id="@+id/casellaData"
        android:layout_width="46dp"
        android:layout_height="wrap_content"
        android:minHeight="48dp"
        android:paddingStart="3dp"
        android:paddingEnd="3dp"
        android:background="@drawable/fondo_data_riquadro"
        android:gravity="center"
        android:orientation="vertical">

        <TextView
            android:id="@+id/testoGiorno"
            android:layout_width="match_parent"
            android:gravity="center"
            android:maxLines="1"
            android:autoSizeTextType="uniform"
            android:autoSizeMinTextSize="7sp"
            android:autoSizeMaxTextSize="10sp"
            android:autoSizeStepGranularity="0.5sp"
            android:layout_height="wrap_content"
            android:fontFamily="@font/jakarta_bold"
            android:letterSpacing="0.06"
            android:textColor="@color/testo_secondario"
            android:textSize="10sp" />

        <TextView
            android:id="@+id/testoNumero"
            android:layout_width="match_parent"
            android:gravity="center"
            android:maxLines="1"
            android:autoSizeTextType="uniform"
            android:autoSizeMinTextSize="7sp"
            android:autoSizeMaxTextSize="19sp"
            android:autoSizeStepGranularity="0.5sp"
            android:layout_height="wrap_content"
            android:fontFamily="@font/jakarta_extrabold"
            android:includeFontPadding="false"
            android:textColor="@color/testo_principale"
            android:textSize="19sp" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/testoTitolo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:fontFamily="@font/jakarta_bold"
            android:maxLines="1"
            android:textColor="@color/testo_principale"
            android:textSize="15sp" />

        <TextView
            android:id="@+id/testoDettaglio"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="1dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="@color/testo_secondario"
            android:textSize="13sp" />
    </LinearLayout>
</LinearLayout>
