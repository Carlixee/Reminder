<?xml version="1.0" encoding="utf-8"?>
<!-- "PAST" at the top of the list, with "Delete all" on the right -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="4dp"
    android:paddingBottom="4dp">

    <TextView
        style="@style/Etichetta"
        android:layout_width="0dp"
        android:layout_weight="1"
        android:text="@string/passati_etichetta"
        android:textColor="@color/testo_tenue" />

    <TextView
        android:id="@+id/bottoneEliminaPassati"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="?attr/selectableItemBackground"
        android:fontFamily="@font/jakarta_bold"
        android:padding="10dp"
        android:text="@string/passati_elimina"
        android:textColor="@color/rosso"
        android:textSize="13sp" />
</LinearLayout>
