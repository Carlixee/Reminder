<?xml version="1.0" encoding="utf-8"?>
<!-- The "i" dialog: the languages drop-down at the top, below it version, privacy and thanks.
     Inside a ScrollView: on a small phone the text scrolls instead of going out. -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="24dp"
        android:paddingTop="12dp"
        android:paddingEnd="24dp">

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/sceltaLingua"
            style="@style/Widget.Material3.TextInputLayout.OutlinedBox.ExposedDropdownMenu"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/lingua_titolo">

            <com.google.android.material.textfield.MaterialAutoCompleteTextView
                android:id="@+id/campoLingua"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="none" />
        </com.google.android.material.textfield.TextInputLayout>

        <TextView
            android:id="@+id/testoInfo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:lineSpacingExtra="2dp"
            android:textAppearance="@style/Jk.BodyMedium"
            android:textColor="?android:attr/textColorSecondary" />

        <!-- The link row to the licences: light blue like the buttons, 48dp tall for the finger -->
        <TextView
            android:id="@+id/linkLicenze"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="?attr/selectableItemBackground"
            android:gravity="center_vertical"
            android:minHeight="48dp"
            android:text="@string/licenze_link"
            android:textAppearance="@style/Jk.BodyMedium"
            android:textColor="?attr/colorPrimary" />

        <!-- The two buttons, always stacked and aligned right: the coffee on top -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/tastoCaffe"
            style="@style/Widget.Material3.Button.TextButton.Dialog"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="end"
            android:layout_marginTop="16dp"
            android:text="@string/caffe" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/tastoChiudi"
            style="@style/Widget.Material3.Button.TextButton.Dialog"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="end"
            android:layout_marginBottom="12dp"
            android:text="@string/chiudi" />
    </LinearLayout>
</ScrollView>
